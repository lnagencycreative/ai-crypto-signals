# Copy to .env and fill in the keys you have. The collector skips any
# provider whose key is missing or blank. Never commit .env.

# OpenAI (ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Google Gemini. GEMINI_API_KEY is preferred. GOOGLE_API_KEY is used
# only when GEMINI_API_KEY is empty.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=

# xAI (Grok)
XAI_API_KEY=
XAI_MODEL=
